# Copy to .env on the VM and fill in. Never commit .env.

# A Hugging Face READ token from an account that accepted the terms of
# pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The VM's public IP with dashes + .sslip.io (a free DNS name that points at that IP),
# e.g. 140-238-12-34.sslip.io. Or your own domain with an A record to the IP.
DOMAIN=0-0-0-0.sslip.io

# Optional
ECHO_THREADS=2
ECHO_MAX_SECONDS=300
ECHO_ORIGINS=https://jnt-h04.github.io
